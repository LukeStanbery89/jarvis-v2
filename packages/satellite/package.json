{
    "name": "@lukestanbery/jarvis-satellite",
    "version": "0.1.0",
    "description": "Headless, mic-first J.A.R.V.I.S. satellite client for macOS and Linux",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "bin": {
        "jarvis-satellite": "dist/index.js"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit -p tsconfig.test.json",
        "dev": "tsx src/index.ts",
        "start": "node dist/index.js",
        "test": "vitest run",
        "prepublishOnly": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/LukeStanbery89/jarvis-v2.git",
        "directory": "packages/satellite"
    },
    "bugs": {
        "url": "https://github.com/LukeStanbery89/jarvis-v2/issues"
    },
    "homepage": "https://github.com/LukeStanbery89/jarvis-v2/tree/main/packages/satellite#readme",
    "license": "MIT",
    "type": "commonjs",
    "dependencies": {
        "@huggingface/transformers": "^4.3.1",
        "@lukestanbery/jarvis-logger": "^0.1.0",
        "@lukestanbery/jarvis-protocol": "^0.1.0",
        "@lukestanbery/jarvis-voice": "^0.1.0",
        "ws": "^8.22.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@types/ws": "^8.18.2",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    }
}
