# Server configuration — copy this file to `.env` and fill in your values.
#
#   cp .env.example .env
#
# Rules:
#   - `.env` is gitignored and must NEVER be committed (it holds secrets).
#   - Real environment variables always win over values in `.env`, so the file
#     is a local-dev convenience; production can (and should) keep setting env
#     in the process environment.
#   - Loaded once at startup by `import "dotenv/config"` in `src/index.ts` for
#     both `npm run dev` (tsx) and `npm start` (node dist).

# --- HTTP ---
PORT=54321
# JARVIS_HOST=0.0.0.0
# JARVIS_TLS_CERT=/absolute/path/to/fullchain.pem
# JARVIS_TLS_KEY=/absolute/path/to/privkey.pem
# JARVIS_HTTP_REDIRECT_PORT=54322

# --- Setup ---
# One-time credential that gates POST /api/bootstrap (first-owner setup).
# Generate one for yourself, e.g. `openssl rand -hex 32`. Single-use per
# server process — never reuse across machines or leaks.
JARVIS_BOOTSTRAP_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Storage ---
# JARVIS_DB_PATH=~/.jarvis/jarvis.sqlite
# JARVIS_CHECKPOINT_PATH=~/.jarvis/checkpoints.sqlite
# JARVIS_TURN_TIMEOUT_MS=120000
# JARVIS_SESSION_TTL_MS=2592000000

# --- Portal ---
# Directory containing the built portal SPA (vite build). Unset = default
# (packages/portal/dist); empty string disables portal serving.
# JARVIS_PORTAL_DIR=

# --- Web chat client ---
# Directory containing the built web chat SPA (vite build). Unset = default
# (packages/web/dist); empty string disables web chat serving.
# JARVIS_WEB_DIR=

# --- Login / bootstrap rate limiting ---
# Fixed window; attempts are counted at admission (before the scrypt verify) and
# a verified login clears the key. Lockout doubles on repeat, up to x32.
# JARVIS_RATE_WINDOW_MS=900000
# JARVIS_RATE_MAX_FAILURES=10
# INERT: parsed but never read — the per-IP aggregate budget currently equals
# JARVIS_RATE_MAX_FAILURES. See issue #66 before relying on this.
# JARVIS_RATE_MAX_IP_FAILURES=100
# JARVIS_RATE_LOCKOUT_MS=60000

# --- Cross-origin / reverse proxy (#63) ---
# Exact browser origins allowed to call the REST API from another machine,
# comma-separated. Unset or empty DENIES all cross-origin requests (same-origin
# clients are unaffected). No wildcard: the API is credentialed. Origins are
# matched case-insensitively and a trailing "/" is ignored.
# JARVIS_CORS_ORIGINS=https://desk.example.com,http://laptop.local:5173
# IPs/subnets whose X-Forwarded-For is believed, comma-separated. Unset trusts
# nothing (safe). Only needed when a reverse proxy fronts the server, so that
# per-IP rate limiting sees real client addresses instead of the proxy's.
# JARVIS_TRUST_PROXY_CIDRS=172.16.0.0/12,10.0.0.5

# --- REST contract verification ---
# /api request shapes are always validated against the OpenAPI contract.
# Setting `verify` ALSO validates response shapes (dev + the contract tests do
# this); off by default in production.
# JARVIS_API_CONTRACT=verify

# --- Logging ---
# JARVIS_LOG_LEVEL=info
# JARVIS_LOG_SENSITIVE=auto

# --- LLM (OpenAI-compatible) ---
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=qwen/qwen3-4b-2507
# LLM_TEMPERATURE=0
# LLM_SYSTEM_PROMPT=You are J.A.R.V.I.S., a helpful, personal AI assistant.
# JARVIS_AGENT_MAX_TURNS=10