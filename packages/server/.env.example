# Server configuration — copy this file to `.env` and fill in your values.
#
#   cp .env.example .env
#
# Rules:
#   - `.env` is gitignored and must NEVER be committed (it holds secrets).
#   - Real environment variables always win over values in `.env`, so the file
#     is a local-dev convenience; production can (and should) keep setting env
#     in the process environment.
#   - Loaded once at startup by `import "dotenv/config"` in `src/index.ts` for
#     both `npm run dev` (tsx) and `npm start` (node dist).

# --- HTTP ---
PORT=54321
# JARVIS_HOST=0.0.0.0
# JARVIS_TLS_CERT=/absolute/path/to/fullchain.pem
# JARVIS_TLS_KEY=/absolute/path/to/privkey.pem
# JARVIS_HTTP_REDIRECT_PORT=54322

# --- Setup ---
# One-time credential that gates POST /api/bootstrap (first-owner setup).
# Generate one for yourself, e.g. `openssl rand -hex 32`. Single-use per
# server process — never reuse across machines or leaks.
JARVIS_BOOTSTRAP_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Storage ---
# JARVIS_DB_PATH=~/.jarvis/jarvis.sqlite
# JARVIS_CHECKPOINT_PATH=~/.jarvis/checkpoints.sqlite
# JARVIS_TURN_TIMEOUT_MS=120000
# JARVIS_SESSION_TTL_MS=2592000000

# --- Portal ---
# Directory containing the built portal SPA (vite build). Unset = default
# (packages/portal/dist); empty string disables portal serving.
# JARVIS_PORTAL_DIR=

# --- Login / bootstrap rate limiting ---
# JARVIS_RATE_WINDOW_MS=900000
# JARVIS_RATE_MAX_FAILURES=10
# JARVIS_RATE_MAX_IP_FAILURES=100
# JARVIS_RATE_LOCKOUT_MS=60000

# --- Logging ---
# JARVIS_LOG_LEVEL=info
# JARVIS_LOG_SENSITIVE=auto

# --- LLM (OpenAI-compatible) ---
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=qwen/qwen3-4b-2507
# LLM_TEMPERATURE=0
# LLM_SYSTEM_PROMPT=You are J.A.R.V.I.S., a helpful, personal AI assistant.
# JARVIS_AGENT_MAX_TURNS=10