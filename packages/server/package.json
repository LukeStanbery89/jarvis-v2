{
    "name": "@lukestanbery/jarvis-server",
    "version": "0.1.0",
    "description": "Express backend server for J.A.R.V.I.S.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "bin": {
        "jarvis-server": "dist/index.js"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit -p tsconfig.test.json",
        "dev": "JARVIS_API_CONTRACT=verify NODE_ENV=development tsx watch src/index.ts",
        "start": "node dist/index.js",
        "test": "vitest run",
        "prepublishOnly": "npm run build",
        "tts:harness": "tsx scripts/tts-harness.ts",
        "chat:dump": "tsx scripts/chat-dump.ts",
        "eval:model-roles": "tsx scripts/modelRolesEval.ts",
        "probe:sandbox": "node scripts/probe-sandbox.mjs",
        "probe:coding-job": "node scripts/probe-coding-job.mjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/LukeStanbery89/jarvis-v2.git",
        "directory": "packages/server"
    },
    "bugs": {
        "url": "https://github.com/LukeStanbery89/jarvis-v2/issues"
    },
    "homepage": "https://github.com/LukeStanbery89/jarvis-v2/tree/main/packages/server#readme",
    "license": "MIT",
    "type": "commonjs",
    "dependencies": {
        "@langchain/core": "^1.2.12",
        "@langchain/langgraph": "^1.4.16",
        "@langchain/langgraph-checkpoint": "^1.1.5",
        "@langchain/langgraph-checkpoint-sqlite": "^1.1.0",
        "@langchain/openai": "^1.5.13",
        "@lukestanbery/jarvis-auth": "^0.1.0",
        "@lukestanbery/jarvis-contracts": "^0.1.0",
        "@lukestanbery/jarvis-logger": "^0.1.0",
        "@lukestanbery/jarvis-protocol": "^0.1.0",
        "better-sqlite3": "^12.11.1",
        "dockerode": "^5.0.1",
        "dotenv": "^18.0.3",
        "express": "^5.2.1",
        "express-openapi-validator": "^5.4.0",
        "web-push": "^3.6.7",
        "ws": "^8.21.3",
        "zod": "^4.6.6"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^9.6.0",
        "@types/dockerode": "^4.0.2",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.2",
        "@types/supertest": "^7.2.1",
        "@types/web-push": "^3.6.4",
        "@types/ws": "^8.18.1",
        "supertest": "^7.2.2",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    },
    "optionalDependencies": {
        "@huggingface/transformers": "^3.5.1",
        "kokoro-js": "^1.2.1"
    }
}
