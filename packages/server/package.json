{
    "name": "@jarvis/server",
    "version": "0.1.0",
    "description": "Express backend server for Jarvis",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "bin": {
        "jarvis-server": "dist/index.js"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit -p tsconfig.test.json",
        "dev": "tsx watch src/index.ts",
        "start": "node dist/index.js",
        "test": "vitest run",
        "prepublishOnly": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/LukeStanbery89/jarvis-v2.git",
        "directory": "packages/server"
    },
    "bugs": {
        "url": "https://github.com/LukeStanbery89/jarvis-v2/issues"
    },
    "homepage": "https://github.com/LukeStanbery89/jarvis-v2/tree/main/packages/server#readme",
    "license": "MIT",
    "type": "commonjs",
    "dependencies": {
        "@langchain/core": "^1.2.12",
        "@langchain/openai": "^1.5.13",
        "express": "^5.2.1",
        "ws": "^8.21.3",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.2",
        "@types/supertest": "^7.2.1",
        "@types/ws": "^8.18.1",
        "supertest": "^7.2.2",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.0.1"
    }
}
