{
    "name": "@lukestanbery/jarvis-cli",
    "version": "0.1.0",
    "description": "CLI text chat client for J.A.R.V.I.S.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "bin": {
        "jarvis": "dist/index.js"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit -p tsconfig.test.json",
        "dev": "tsx src/index.ts",
        "start": "node dist/index.js",
        "test": "vitest run",
        "prepublishOnly": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/LukeStanbery89/jarvis-v2.git",
        "directory": "packages/cli"
    },
    "bugs": {
        "url": "https://github.com/LukeStanbery89/jarvis-v2/issues"
    },
    "homepage": "https://github.com/LukeStanbery89/jarvis-v2/tree/main/packages/cli#readme",
    "license": "MIT",
    "type": "commonjs",
    "dependencies": {
        "@lukestanbery/jarvis-logger": "^0.1.0",
        "@lukestanbery/jarvis-protocol": "^0.1.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.2",
        "@types/ws": "^8.18.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.0.1",
        "ws": "^8.21.3"
    }
}
