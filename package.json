{
    "name": "jarvis-v2",
    "version": "1.0.0",
    "private": true,
    "description": "AI-powered assistant monorepo",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "npm run build -w @lukestanbery/jarvis-protocol -w @lukestanbery/jarvis-logger -w @lukestanbery/jarvis-auth -w @lukestanbery/jarvis-cli -w @lukestanbery/jarvis-contracts -w @lukestanbery/jarvis-server -w @lukestanbery/jarvis-portal -w @lukestanbery/jarvis-web",
        "check": "npm run check:deps && npm run lint && npm run build && npm run typecheck && npm test && npm run test:scripts && npm run format:check",
        "check:deps": "node scripts/check-dependencies.mjs",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test:scripts": "vitest run scripts",
        "graph:update": "graphify update .",
        "graph:update:force": "graphify update . --force",
        "graph:status": "graphify hook status",
        "graph:health": "graphify diagnose multigraph",
        "graph:hook:install": "graphify hook install",
        "graph:hook:uninstall": "graphify hook uninstall",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky",
        "test": "npm run test --workspaces --if-present",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "prepublishOnly": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/LukeStanbery89/jarvis-v2.git"
    },
    "bugs": {
        "url": "https://github.com/LukeStanbery89/jarvis-v2/issues"
    },
    "homepage": "https://github.com/LukeStanbery89/jarvis-v2#readme",
    "license": "MIT",
    "devDependencies": {
        "esbuild": "^0.28.2",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.0",
        "prettier": "^3.9.8",
        "typescript-eslint": "^8.71.0",
        "vitest": "^5.0.1"
    },
    "allowScripts": {
        "better-sqlite3@12.11.1": true
    }
}
